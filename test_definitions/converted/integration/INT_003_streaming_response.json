{
  "id": "INT_003",
  "name": "Streaming response integration test",
  "suite": "integration",
  "type": "single",
  "priority": 4,
  "tags": ["streaming", "response", "integration"],
  
  "config": {
    "timeout": 45,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["streaming", "multi_agent"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_int_003",
      "profile": {
        "name": "Test User",
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "text/event-stream"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "请详细介绍一下新冠疫苗的作用机制和注意事项",
      "user_id": "${user_context.user_id}",
      "stream": true,
      "metadata": {
        "test_id": "${id}",
        "test_name": "${name}"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "headers": {
        "Content-Type": "text/event-stream"
      },
      "output_contains": [
        "疫苗",
        "作用机制",
        "注意事项"
      ],
      "output_excludes": [
        "错误",
        "失败"
      ],
      "min_length": 200,
      "max_length": 3000
    },
    
    "reasoning": {
      "steps_min": 3,
      "contains_keywords": [
        "vaccine",
        "mechanism",
        "medical_info"
      ]
    },
    
    "agents": {
      "touched": ["router_agent", "rag_agent", "response_agent"],
      "max_agents": 4
    },
    
    "server_logs": {
      "contains": [
        "Streaming enabled",
        "SSE response",
        "Medical information"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL",
        "Streaming failed"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=2"
      }
    },
    
    "performance": {
      "response_time_max": 20.0,
      "memory_usage_max": "100MB",
      "token_usage_max": 1200
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}