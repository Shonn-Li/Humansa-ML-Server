{
  "id": "ORC_002",
  "name": "Workflow API Integration - Non-Streaming Mode",
  "suite": "orchestrator",
  "type": "single",
  "priority": 3,
  "tags": ["workflow", "non-streaming", "integration", "appointment"],
  "config": {
    "timeout": 45,
    "retries": 1,
    "parallel_safe": false,
    "requirements": ["server_running", "workflow_orchestrator_enabled"]
  },
  "setup": {
    "user_context": {
      "user_id": "test_user_workflow",
      "profile": {}
    },
    "environment": {
      "use_workflow": "true"
    }
  },
  "execution": {
    "endpoint": "/v2/humansa/chat",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "user_id": "test_user_workflow",
      "messages": [
        {"role": "user", "content": "我需要预约心内科医生"}
      ],
      "stream": false,
      "use_workflow": true
    }
  },
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": ["预约", "心内科", "医生"],
      "min_length": 50
    },
    "reasoning": {
      "contains_keywords": ["预约", "心内科"],
      "tool_calls": ["appointment_search", "doctor_lookup"]
    },
    "agents": {
      "touched": ["AppointmentAgent", "MedicalAgent"],
      "max_agents": 3
    },
    "context": {
      "workflow": {
        "final_state": {
          "appointment_context": "present"
        }
      }
    },
    "server_logs": {
      "contains": ["WorkflowOrchestrator", "appointment"],
      "excludes": ["ERROR", "CRITICAL"]
    },
    "performance": {
      "response_time_max": 25.0
    }
  },
  "cleanup": {
    "reset_context": true
  }
}