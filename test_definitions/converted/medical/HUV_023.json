    },
    "server_logs": {
      "contains": ["Pattern 2", "emergency", "urgent"],
      "excludes": ["ERROR", "exception"],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": ">=1"
      }
    },
    "performance": {
      "response_time_max": 15,
      "token_usage_max": 800
