{
  "id": "APF_008",
  "name": "Urgent Symptom Handling",
  "suite": "emergency",
  "type": "single",
  "priority": 5,
  "tags": ["emergency", "urgent", "symptom", "medical", "chinese"],
  "config": {
    "timeout": 30,
    "retries": 0,
    "parallel_safe": true,
    "requirements": ["appointment_form_system", "emergency_detection", "humansa_v2"]
  },
  "setup": {
    "user_context": {
      "user_id": "test_user_apf_008",
      "profile": {}
    },
    "previous_turns": [],
    "environment": {}
  },
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer test-api-key",
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4-turbo",
      "input": "我胸口剧痛，呼吸困难，头晕",
      "user_id": "test_user_apf_008"
    }
  },
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": ["120", "急救", "立即", "紧急"],
      "min_length": 100
    },
    "reasoning": {
      "steps_min": 2,
      "contains_keywords": ["emergency", "urgent", "chest_pain", "breathing_difficulty"],
      "tool_calls": ["emergency_symptom_detection", "emergency_response"]
    },
    "agents": {
      "touched": ["EmergencyAgent", "MedicalAgent"],
      "max_agents": 3
    },
    "context": {
      "workflow": {
        "state_changes": {
          "emergency_status": "detected"
        },
        "events_emitted": ["emergency_detected", "emergency_response_triggered"]
      }
    },
    "server_logs": {
      "contains": ["emergency detected", "urgent symptoms"],
      "excludes": ["ERROR", "exception"],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": ">=1"
      }
    },
    "performance": {
      "response_time_max": 20,
      "token_usage_max": 1000
    }
  },
  "cleanup": {
    "commands": [],
    "reset_context": false
  }
}