{
  "id": "HUV_021",
  "name": "Sleep Issues Consultation",
  "suite": "medical_consultation",
  "type": "single",
  "priority": 4,
  "tags": ["medical", "consultation", "sleep", "insomnia", "chinese"],
  "config": {
    "timeout": 30,
    "retries": 0,
    "parallel_safe": true,
    "requirements": ["humansa_v2", "pattern2", "medical_knowledge"]
  },
  "setup": {
