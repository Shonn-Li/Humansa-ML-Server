{
  "id": "SIM_008",
  "name": "Simple Test Case 8",
  "suite": "integration",
  "type": "single",
  "priority": 1,
  "tags": ["simple", "test8"],
  
  "config": {
    "timeout": 30,
    "retries": 1,
    "parallel_safe": true
  },
  
  "execution": {
    "endpoint": "/v1/chat/completions",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "messages": [{"role": "user", "content": "This is test number 8. Please respond with 'Test 8 acknowledged'."}],
      "user_id": 1000008,
      "max_tokens": 50
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": ["Test", "8", "acknowledged"],
      "min_length": 10
    }
  }
}
