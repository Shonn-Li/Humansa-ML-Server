    "retries": 0,
    "parallel_safe": true,
    "requirements": ["humansa_v2", "pattern2", "emergency_detection"]
  },
  "setup": {
    "user_context": {
      "user_id": "test_user_023",
      "profile": {}
    },
    "previous_turns": [],
    "environment": {
      "HUMANSA_USE_PATTERN2": "true"
    }
  },
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "胸口疼痛呼吸困难",
      "user_id": "test_user_023",
      "metadata": {
        "test_id": "HUV_023",
        "test_name": "Emergency Symptoms Detection",
