{
  "id": "HUM_004",
  "name": "Web Search Current Events Test",
  "suite": "appointment",
  "type": "single",
  "priority": 4,
  "tags": ["humansa", "web-search", "current-events", "citations"],
  "config": {
    "timeout": 60,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["multi_agent_endpoint_v2", "web_search"]
  },
  "setup": {
    "user_context": {
      "user_id": "10001"
    }
  },
  "execution": {
    "endpoint": "/v2/multi-agent/chat",
    "method": "POST",
    "payload": {
      "model": "gpt-4.1-nano",
      "messages": [{"role": "user", "content": "What are the latest developments in quantum computing 2025?"}],
      "stream": true,
      "enable_citations": true,
      "user_id": 10001
    }
  },
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": ["quantum", "2025"]
    },
    "agents": {
      "touched": ["web_search"],
      "max_agents": 2
    },
    "custom_validators": ["validate_citations_present", "validate_web_search_used"]
  }
}