{
  "id": "INT_004",
  "name": "Multi-agent coordination integration test",
  "suite": "integration",
  "type": "single",
  "priority": 5,
  "tags": ["multi_agent", "coordination", "integration"],
  
  "config": {
    "timeout": 60,
    "retries": 1,
    "parallel_safe": false,
    "requirements": ["multi_agent", "coordination", "tool_calls"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_int_004",
      "profile": {
        "name": "Test User",
        "age": 45,
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "我最近感觉胸闷气短，想预约心内科专家，并且了解一下相关的保健品",
      "user_id": "test_user_int_004",
      "metadata": {
        "test_id": "INT_004",
        "test_name": "Multi-agent coordination integration test"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "胸闷气短",
        "心内科",
        "专家",
        "预约",
        "保健品"
      ],
      "output_excludes": [
        "错误",
        "失败"
      ],
      "min_length": 300,
      "max_length": 3000
    },
    
    "reasoning": {
      "steps_min": 4,
      "contains_keywords": [
        "symptoms",
        "appointment",
        "cardiology",
        "health_products"
      ],
      "tool_calls": [
        "search_doctors",
        "product_search",
        "create_appointment_form"
      ]
    },
    
    "agents": {
      "touched": ["router_agent", "rag_agent", "response_agent"],
      "call_order": ["router_agent", "rag_agent", "response_agent"],
      "max_agents": 4
    },
    
    "context": {
      "mem0": {
        "should_store": [
          "medical_symptoms",
          "doctor_specialty_preference",
          "health_product_interest"
        ]
      }
    },
    
    "server_logs": {
      "contains": [
        "Multiple agents coordination",
        "Medical query processing",
        "Product search integration"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL",
        "Agent coordination failed"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=2"
      }
    },
    
    "performance": {
      "response_time_max": 25.0,
      "memory_usage_max": "150MB",
      "token_usage_max": 1500
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}