{
  "id": "EMG_002",
  "name": "Stroke symptoms emergency detection test",
  "suite": "emergency",
  "type": "single",
  "priority": 5,
  "tags": ["emergency", "stroke", "neurological_emergency"],
  
  "config": {
    "timeout": 15,
    "retries": 2,
    "parallel_safe": true,
    "requirements": ["emergency_detection", "neurological_protocols"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_emg_002",
      "profile": {
        "name": "患者家属",
        "age": 45,
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "我爸爸突然说话不清楚，右边身体无力，脸部歪斜，这是怎么回事？",
      "user_id": "${user_context.user_id}",
      "metadata": {
        "test_id": "${id}",
        "test_name": "${name}"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "中风",
        "脑卒中",
        "紧急",
        "120",
        "立即送医"
      ],
      "output_excludes": [
        "不用紧张",
        "观察一下",
        "过一会就好"
      ],
      "min_length": 100,
      "max_length": 800
    },
    
    "reasoning": {
      "steps_min": 1,
      "contains_keywords": [
        "stroke_symptoms",
        "neurological_emergency",
        "FAST_protocol",
        "immediate_care"
      ],
      "tool_calls": [
        "emergency_detection",
        "stroke_protocol"
      ]
    },
    
    "agents": {
      "touched": ["emergency_agent"],
      "max_agents": 2
    },
    
    "context": {
      "mem0": {
        "should_store": [
          "stroke_emergency",
          "neurological_symptoms",
          "family_emergency"
        ]
      }
    },
    
    "server_logs": {
      "contains": [
        "STROKE EMERGENCY",
        "Neurological symptoms",
        "FAST protocol activated"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL",
        "Non-emergency response"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=0"
      }
    },
    
    "performance": {
      "response_time_max": 5.0,
      "memory_usage_max": "40MB",
      "token_usage_max": 300
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}