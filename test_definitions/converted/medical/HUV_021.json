      "user_id": "test_user_021",
      "profile": {}
    },
    "previous_turns": [],
    "environment": {
      "HUMANSA_USE_PATTERN2": "true"
    }
  },
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4-turbo",
      "input": "我最近总是失眠怎么办？",
      "user_id": "test_user_021",
      "metadata": {
        "test_id": "HUV_021",
        "test_name": "Sleep Issues Consultation",
        "orchestrator": "pattern2"
      }
    }
  },
  "expectations": {
