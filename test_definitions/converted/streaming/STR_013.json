{
  "id": "STR_013",
  "name": "Streaming Interruption Recovery Test",
  "suite": "streaming",
  "type": "single",
  "priority": 4,
  "tags": ["streaming", "interruption", "recovery", "resilience"],
  "config": {
    "timeout": 45,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["streaming_api", "interruption_handling"]
  },
  "setup": {
    "user_context": {
      "user_id": "test_user_stream_013"
    }
  },
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "payload": {
      "model": "gpt-4-turbo",
      "input": "请写一篇关于中医养生的长篇文章",
      "user_id": "test_user_stream_013",
      "stream": true,
      "metadata": {
        "test_id": "STREAM_013",
        "test_name": "streaming_interruption"
      }
    }
  },
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": ["中医", "养生"]
    },
    "custom_validators": ["validate_interruption_handling", "validate_partial_chunks"]
