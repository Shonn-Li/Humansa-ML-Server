{
  "id": "VAL_001",
  "name": "Input validation test",
  "suite": "validation",
  "type": "single",
  "priority": 3,
  "tags": ["validation", "input_sanitization", "security"],
  
  "config": {
    "timeout": 20,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["input_validation", "security_checks"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_val_001",
      "profile": {
        "name": "测试用户",
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "<script>alert('test')</script> 我想了解健康产品",
      "user_id": "${user_context.user_id}",
      "metadata": {
        "test_id": "${id}",
        "test_name": "${name}"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "健康产品",
        "了解"
      ],
      "output_excludes": [
        "<script>",
        "alert",
        "javascript"
      ],
      "min_length": 50,
      "max_length": 1000
    },
    
    "reasoning": {
      "steps_min": 1,
      "contains_keywords": [
        "input_sanitized",
        "health_products",
        "safe_processing"
      ]
    },
    
    "agents": {
      "touched": ["router_agent"],
      "max_agents": 2
    },
    
    "server_logs": {
      "contains": [
        "Input validation",
        "Script tags removed",
        "Safe processing"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL",
        "XSS attempt"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=1"
      }
    },
    
    "performance": {
      "response_time_max": 10.0,
      "memory_usage_max": "50MB",
      "token_usage_max": 300
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}