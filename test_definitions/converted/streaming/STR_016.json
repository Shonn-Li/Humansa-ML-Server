{
  "id": "STR_016",
  "name": "Streaming Timeout Handling Test",
  "suite": "streaming",
  "type": "single",
  "priority": 3,
  "tags": ["streaming", "timeout", "error-handling"],
  "config": {
    "timeout": 5,
    "retries": 0,
    "parallel_safe": true,
    "requirements": ["streaming_api", "timeout_handling"]
  },
  "setup": {
    "user_context": {
      "user_id": "test_user_stream_016"
    }
  },
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "payload": {
      "model": "gpt-4.1",
      "input": "请进行复杂的医学分析",
      "user_id": "test_user_stream_016",
      "stream": true,
      "timeout": 1,
      "metadata": {
        "test_id": "STREAM_016",
        "test_name": "streaming_timeout"
      }
    }
  },
  "expectations": {
    "response": {
      "status_code": 408
    },
    "performance": {
      "response_time_max": 5
    },
    "server_logs": {
      "contains": ["timeout"],
      "excludes": ["CRITICAL"]
    },
    "custom_validators": ["validate_timeout_handling"]
  }
}