{
  "id": "INT_002",
  "name": "Agent routing integration test",
  "suite": "integration",
  "type": "single",
  "priority": 4,
  "tags": ["routing", "agents", "integration"],
  
  "config": {
    "timeout": 30,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["multi_agent", "intelligent_router"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_int_002",
      "profile": {
        "name": "Test User",
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "我想搜索一些关于维生素C的产品信息",
      "user_id": "${user_context.user_id}",
      "metadata": {
        "test_id": "${id}",
        "test_name": "${name}"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "维生素C",
        "产品",
        "信息"
      ],
      "output_excludes": [
        "错误",
        "失败"
      ],
      "min_length": 100,
      "max_length": 2000
    },
    
    "reasoning": {
      "steps_min": 2,
      "contains_keywords": [
        "product_search",
        "vitamin_c",
        "routing"
      ],
      "tool_calls": [
        "product_search"
      ]
    },
    
    "agents": {
      "touched": ["router_agent", "rag_agent"],
      "call_order": ["router_agent", "rag_agent"],
      "max_agents": 3
    },
    
    "server_logs": {
      "contains": [
        "Router agent",
        "Product search",
        "RAG agent"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=1"
      }
    },
    
    "performance": {
      "response_time_max": 15.0,
      "memory_usage_max": "80MB",
      "token_usage_max": 800
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}