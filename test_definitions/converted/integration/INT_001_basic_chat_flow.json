{
  "id": "INT_001",
  "name": "Basic chat flow integration test",
  "suite": "integration",
  "type": "single",
  "priority": 3,
  "tags": ["basic", "chat", "flow", "integration"],
  
  "config": {
    "timeout": 30,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["multi_agent", "streaming"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_int_001",
      "profile": {
        "name": "Test User",
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "你好，我想咨询一下健康问题",
      "user_id": "${user_context.user_id}",
      "metadata": {
        "test_id": "${id}",
        "test_name": "${name}"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "你好",
        "健康",
        "咨询"
      ],
      "output_excludes": [
        "错误",
        "失败"
      ],
      "min_length": 50,
      "max_length": 2000
    },
    
    "reasoning": {
      "steps_min": 1,
      "contains_keywords": [
        "health",
        "consultation",
        "greeting"
      ]
    },
    
    "agents": {
      "touched": ["router_agent"],
      "max_agents": 3
    },
    
    "server_logs": {
      "contains": [
        "Request received",
        "Router agent",
        "Response generated"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=1"
      }
    },
    
    "performance": {
      "response_time_max": 10.0,
      "memory_usage_max": "50MB",
      "token_usage_max": 500
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}