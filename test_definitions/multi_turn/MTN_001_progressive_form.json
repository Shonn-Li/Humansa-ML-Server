{
  "id": "MTN_001",
  "name": "Progressive form filling over multiple turns",
  "suite": "multi_turn",
  "type": "multi_turn",
  "priority": 4,
  "tags": ["form", "conversation", "context"],
  
  "config": {
    "timeout": 60,
    "retries": 0,
    "parallel_safe": true,
    "requirements": ["pattern2", "form_system", "context_manager"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_mtn_001",
      "profile": {}
    },
    "previous_turns": [
      {
        "role": "user",
        "content": "我想预约看头痛"
      },
      {
        "role": "assistant",
        "content": "好的，我可以帮您预约看头痛。请问您想预约哪位医生？什么时间方便？"
      },
      {
        "role": "user",
        "content": "李明医生吧，明天上午可以吗"
      },
      {
        "role": "assistant",
        "content": "好的，明天上午李明医生有以下时间段可以预约：9:00、10:00、11:00。请问您选择哪个时间？另外，请提供您的姓名和联系方式。"
      }
    ]
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4-turbo",
      "input": "9点吧，我叫张三，电话13800138000",
      "user_id": "${user_context.user_id}",
      "previous_response_id": "${previous_response.id}",
      "metadata": {
        "test_id": "${id}",
        "test_name": "${name}"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "张三",
        "13800138000",
        "李明医生",
        "明天",
        "上午9",
        "头痛",
        "预约信息",
        "确认"
      ],
      "output_excludes": [
        "请提供",
        "还需要"
      ],
      "min_length": 100
    },
    
    "reasoning": {
      "steps_min": 2,
      "contains_keywords": [
        "updating form",
        "completing appointment",
        "all required information"
      ],
      "tool_calls": [
        "update_appointment_form",
        "validate_form_completion"
      ]
    },
    
    "agents": {
      "touched": ["FormUpdater", "FormValidator"],
      "max_agents": 3
    },
    
    "context": {
      "mem0": {
        "should_retrieve": [
          "doctor_name",
          "appointment_time",
          "symptoms"
        ],
        "should_store": [
          "patient_name",
          "patient_phone",
          "complete_appointment"
        ]
      },
      "workflow": {
        "state_changes": {
          "form_updated": true,
          "form_completed": true,
          "ready_for_confirmation": true
        },
        "final_state": {
          "form_status": "complete",
          "missing_fields": []
        }
      }
    },
    
    "server_logs": {
      "contains": [
        "Retrieved conversation context",
        "Form updated with patient information",
        "Form validation passed",
        "All required fields present"
      ],
      "excludes": [
        "ERROR",
        "Form validation failed"
      ]
    },
    
    "performance": {
      "response_time_max": 7.0,
      "memory_usage_max": "150MB",
      "token_usage_max": 1500
    }
  },
  
  "cleanup": {
    "commands": [
      "DELETE FROM test_management.test_case_logs WHERE result_id = '${result.id}'"
    ],
    "reset_context": true
  }
}