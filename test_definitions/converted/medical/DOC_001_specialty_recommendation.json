{
  "id": "DOC_001",
  "name": "Doctor specialty recommendation based on symptoms",
  "suite": "medical_consultation",
  "type": "single",
  "priority": 4,
  "tags": ["doctor_recommendation", "specialty", "symptoms"],
  
  "config": {
    "timeout": 30,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["medical_knowledge", "doctor_database"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_doc_001",
      "profile": {
        "name": "患者李先生",
        "age": 45,
        "gender": "male",
        "language": "zh"
      }
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "我最近胸闷气短，有时候心跳很快，应该看什么科的医生？",
      "user_id": "test_user_doc_001",
      "metadata": {
        "test_id": "DOC_001",
        "test_name": "Doctor specialty recommendation based on symptoms"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "心内科",
        "胸闷气短",
        "心跳",
        "医生",
        "建议"
      ],
      "output_excludes": [
        "错误",
        "失败"
      ],
      "min_length": 100,
      "max_length": 1500
    },
    
    "reasoning": {
      "steps_min": 2,
      "contains_keywords": [
        "cardiology",
        "chest_symptoms",
        "heart_rate",
        "specialty_match"
      ],
      "tool_calls": [
        "analyze_symptoms",
        "recommend_specialty"
      ]
    },
    
    "agents": {
      "touched": ["router_agent", "rag_agent"],
      "max_agents": 3
    },
    
    "context": {
      "mem0": {
        "should_store": [
          "chest_discomfort_symptoms",
          "cardiology_referral",
          "heart_rate_concerns"
        ]
      }
    },
    
    "server_logs": {
      "contains": [
        "Symptom analysis",
        "Specialty recommendation",
        "Cardiology match"
      ],
      "excludes": [
        "ERROR",
        "CRITICAL"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": "<=1"
      }
    },
    
    "performance": {
      "response_time_max": 15.0,
      "memory_usage_max": "80MB",
      "token_usage_max": 600
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}