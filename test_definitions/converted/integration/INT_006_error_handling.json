{
  "id": "INT_006",
  "name": "Error handling integration test",
  "suite": "integration",
  "type": "single",
  "priority": 4,
  "tags": ["error_handling", "resilience", "integration"],
  
  "config": {
    "timeout": 30,
    "retries": 2,
    "parallel_safe": true,
    "requirements": ["error_recovery", "logging"]
  },
  
  "setup": {
    "user_context": {
      "user_id": "test_user_int_006",
      "profile": {
        "name": "Test User",
        "language": "zh"
      }
    },
    "environment": {
      "FORCE_ERROR_SCENARIO": "agent_timeout"
    }
  },
  
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "input": "查询一个不存在的产品分类XYZABC123",
      "user_id": "test_user_int_006",
      "metadata": {
        "test_id": "INT_006",
        "test_name": "Error handling integration test"
      }
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": [
        "没有找到",
        "分类",
        "建议"
      ],
      "output_excludes": [
        "系统错误",
        "500",
        "CRITICAL"
      ],
      "min_length": 50,
      "max_length": 1000
    },
    
    "reasoning": {
      "steps_min": 2,
      "contains_keywords": [
        "not_found",
        "graceful_handling",
        "suggestion"
      ]
    },
    
    "agents": {
      "touched": ["router_agent", "rag_agent"],
      "max_agents": 3
    },
    
    "server_logs": {
      "contains": [
        "Product not found",
        "Graceful error handling",
        "Alternative suggestions"
      ],
      "excludes": [
        "CRITICAL",
        "Unhandled exception"
      ],
      "log_levels": {
        "ERROR": "=0",
        "WARNING": ">=1"
      }
    },
    
    "performance": {
      "response_time_max": 15.0,
      "memory_usage_max": "60MB",
      "token_usage_max": 400
    }
  },
  
  "cleanup": {
    "reset_context": true
  }
}