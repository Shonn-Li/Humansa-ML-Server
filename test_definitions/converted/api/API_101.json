{
  "id": "API_101",
  "name": "Linear Medical Consultation Response Creation Test",
  "suite": "api",
  "type": "single",
  "priority": 4,
  "tags": ["api", "responses", "medical", "consultation", "linear"],
  "config": {
    "timeout": 45,
    "retries": 1,
    "parallel_safe": true,
    "requirements": ["responses_api", "openai_style"]
  },
  "setup": {
    "user_context": {
      "user_id": "test_user_456"
    }
  },
  "execution": {
    "endpoint": "/v2/humansa/responses/create",
    "method": "POST",
    "payload": {
      "model": "gpt-4-turbo",
      "input": "你好，我最近总是失眠",
