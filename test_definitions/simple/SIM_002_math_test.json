{
  "id": "SIM_002",
  "name": "Simple Math Test",
  "suite": "integration",
  "type": "single",
  "priority": 1,
  "tags": ["simple", "math", "calculation"],
  
  "config": {
    "timeout": 30,
    "retries": 1,
    "parallel_safe": true
  },
  
  "execution": {
    "endpoint": "/v1/chat/completions",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "payload": {
      "model": "gpt-4.1",
      "messages": [{"role": "user", "content": "What is 2 + 2?"}],
      "user_id": 1000002,
      "max_tokens": 50
    }
  },
  
  "expectations": {
    "response": {
      "status_code": 200,
      "output_contains": ["4"],
      "min_length": 1
    }
  }
}